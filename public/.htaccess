<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and non-www (apex domain)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.uncodedhub\.com$ [NC]
  RewriteRule ^(.*)$ https://uncodedhub.com/$1 [L,R=301]

  # 2. Canonical Trailing Slash Enforcement (fixes Google Search Console duplicate URL split)
  # Automatically 301 redirects /path -> /path/ for clean canonical consolidation.
  # Excludes real files and paths with asset extensions (.css, .js, .png, .webp, .xml, .txt, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/.*\.([a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://uncodedhub.com/$1/ [L,R=301]

  # 3. Clean query parameter canonicalization (?book=true -> /contact/)
  RewriteCond %{THE_REQUEST} \s/contact\?book=true [NC]
  RewriteRule ^contact$ https://uncodedhub.com/contact/ [L,R=301]
</IfModule>

# Real 404 status for anything that isn't a prerendered route or static asset
ErrorDocument 404 /404.html

# ── Performance & Core Web Vitals Optimization ───────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Security & Header Standards ─────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
